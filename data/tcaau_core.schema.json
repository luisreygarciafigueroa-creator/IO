            "schlafli": { "type": "string", "const": "{4,3,3}" },
            "vertices": { "type": "integer", "const": 16 },
            "edges": { "type": "integer", "const": 32 },
            "faces": { "type": "integer", "const": 24 },
            "cells": { "type": "integer", "const": 8 },
            "euler_characteristic_4d": { "type": "integer", "const": 0 },
            "dual": { "type": "string" }
