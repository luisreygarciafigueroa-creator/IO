                  "maxItems": 4,
                  "items": { "type": "string" }
                },
                "inverted_punteado_real_cells": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "string" }
                }
              }
            },
            "loop_reading_rule": {
              "type": "object",
              "required": ["antihorario", "horario", "epistemic_note"],
