      }
    },
    "site_integration_11": {
      "type": "object",
      "required": [
        "scope_rule",
        "creation_rules_11_2",
        "traceability_11_3",
        "closure_criterion_11_4",
        "ideas_and_encounter_11_5",
        "t12_priority_route_11_6",
        "integration_table"
      ],
      "additionalProperties": false,
      "properties": {
        "scope_rule": { "type": "string" },
        "creation_rules_11_2": { "type": "string" },
