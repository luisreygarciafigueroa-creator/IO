                  "cell_id",
                  "domain_legend",
                  "real_transition",
                  "virtual_transition",
                  "straight_transition",
                  "loop_transition",
                  "loop_sense"
                ],
                "additionalProperties": false,
                "properties": {
                  "cell_label": { "type": "string" },
                  "cell_id": { "type": "string" },
                  "domain_legend": { "type": "string", "enum": ["continuo = real", "punteado = real"] },
                  "real_transition": { "type": "string" },
                  "virtual_transition": { "type": "string" },
                  "straight_transition": { "type": "string" },
                  "loop_transition": { "type": "string" },
                  "loop_sense": { "type": "string", "enum": ["antihorario", "horario"] }
                }
