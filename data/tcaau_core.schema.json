                "horario": { "type": "string" },
                "epistemic_note": { "type": "string" }
              }
            },
            "per_arrow_domain_balance": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["arrow", "real_count", "virtual_count", "total"],
                "additionalProperties": false,
                "properties": {
                  "arrow": { "type": "string" },
                  "real_count": { "type": "integer", "const": 2 },
                  "virtual_count": { "type": "integer", "const": 2 },
                  "total": { "type": "integer", "const": 4 }
                }
              }
            },
            "arrow_multiplicity": { "type": "integer", "const": 4 },
